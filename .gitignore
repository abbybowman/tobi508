# Virtual environments
.venv/
venv/

# Environment variables (keep .env.example, never commit .env)
.env

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Ruff
.ruff_cache/

# IDE / editor
.vscode/
.idea/
.zed/
*.swp


# Run output (evidence, HAR files, screenshots, reports)
runs/
# Agent eval rounds keep their tool runs' reports, pre-SCRT files and step
# logs; page recordings, screenshots and evidence stay out of git, in the
# round's archive (evals/judging/<round>/results/ARCHIVE.md).
!evals/judging/*/results/*/runs/
!evals/judging/*/attempts/*/runs/
evals/judging/**/*.har.zip
evals/judging/**/*.png
evals/judging/**/runs/*/evidence/
# Gate-style compare rounds: per-page pre-SCRT copies are derivable from report.json
evals/judging/compare-*/results/c/r*/results/*/pre-scrt.json
# ... and the agent arms' full transcripts (megabytes each); compare.json keeps the counts
evals/judging/compare-*/results/arm-*/transcript.json
tests/.act_scores/

# Other temp files
temp/
# Agent eval: Playwright MCP (npm install in evals/agent/node)
node_modules/

# Development rounds (never locked or scored as a round): keep each arm's
# summary, final message, debrief and step log; their tool runs and
# transcripts (megabytes of inline screenshots) stay local (Abby, 2026-11-06).
evals/judging/round1-postfix/results/*/runs/
evals/judging/round1-postfix/results/*/transcript.json
/archives/

# ApiJudge gate runs: the report and pre-SCRT files of each page (the real run's
# results and a dry run's copies, with or without a round level) are kept
# locally; gate.json, run.json, the compare files and the eval results are
# what goes in git.
evals/judging/gate-*/r*/results/
evals/judging/gate-*/round*/r*/results/
evals/judging/gate-*/dry/
evals/judging/gate-*/round*/dry/
